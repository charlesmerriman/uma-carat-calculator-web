<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hand-maintained: this site has a small fixed route set, so a generator would
  be more moving parts than the thing it generates. Add a line here when you add
  a public route.

  /login and /auth/callback are deliberately absent - they carry no content and
  set a noindex meta tag. They are NOT excluded in robots.txt; see the comment
  there for why disallowing them would defeat the noindex.

  The absolute URLs below do NOT survive a domain move. Update them together
  with the Sitemap line in robots.txt and the og:url / og:image / twitter:image
  tags in index.html - three files, one domain, no generator tying them.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
